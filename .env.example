# This backend's own base URL, used to build the OAuth redirect_uri --
# must match what's registered in Authentik (redirect URI is
# {BACKEND_BASE_URL}/auth/callback).
BACKEND_BASE_URL=http://localhost:8000

# Authentik OAuth2/OIDC (mirrors studio's own setup). Requires its own
# Authentik application/client registration, separate from studio's and
# scepa-rs's -- if you previously registered one for scepa-rs's metadata
# server, update its redirect URI to point here instead (or register a
# new application) before this will work.
OAUTH_DISCOVERY_URL=
OAUTH_LOGOUT_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
SESSION_SECRET=

# The frontend's own origin (dev: the Vite dev server). Used for the CORS
# allow-list and as the redirect target after a successful login.
FRONTEND_URL=http://localhost:5173

# scepa-rs metadata server (PUT/GET/PATCH /metadata/{sha256}). This
# backend is the only thing that calls it, authenticating with a static
# bearer key -- the browser never sees or needs one.
SCEPA_METADATA_URL=http://localhost:8081
SCEPA_METADATA_API_KEY=
